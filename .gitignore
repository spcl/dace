.dacecache*
# Stray in-repo-root cmake build output (the bridge builds under
# dace/frontend/hlfir/build; these only appear from an accidental
# top-level cmake invocation).
/CMakeCache.txt
/CMakeFiles/
/cmake_install.cmake
/Makefile
/lib*.a

# Local secrets / tokens
.mtoken
dace/transformation/layout/cost_model/build/

# cloudsc_variants perf job: cached Phase-A parallelized SDFG (expensive to rebuild)
performance_regression_jobs/cloudsc_variants/cache/

# Local perf-job trees. These are working files for cluster runs, not repo content --
# they live outside the checkout so `git add -A` cannot pull them back in.
/performance_regression_jobs/
/codegen_buildperf_jobs/
/cpu_codegen_perf_jobs/
/local/
# A/B scratch: job logs plus two live `git worktree` checkouts (wt-base, wt-new). Ignored rather
# than tidied away because `git add -A` would otherwise commit nested checkouts into the tree.
/perf_ab/
issues/

# Core dumps from forked kernel processes (fork isolation is deliberate; the cores are not).
core_nid*
core.*
