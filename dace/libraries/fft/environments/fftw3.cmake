# FFTW3 for the FFTW3 environment, each precision as far as the install provides it: the CMake package's target where
# the install exports a usable one, else pkg-config (Ubuntu ships only .pc files; conda-forge's FFTW3::fftw3 has no
# library location, and FFTW3f::fftw3f is missing). Neither names the threads library, so the OpenMP planner beside
# the found library links ahead of it when present.
if(DEFINED ENV{FFTW_ROOT})
  list(APPEND CMAKE_PREFIX_PATH $ENV{FFTW_ROOT})
endif()
find_package(PkgConfig QUIET)
set(DACE_FFTW3_FOUND OFF)
foreach(DACE_FFTW3_P "" f)
  find_package(FFTW3${DACE_FFTW3_P} CONFIG QUIET)
  set(DACE_FFTW3_LOCATION NOTFOUND)
  set(DACE_FFTW3_CONFIGS NOTFOUND)
  if(TARGET FFTW3::fftw3${DACE_FFTW3_P})
    get_target_property(DACE_FFTW3_LOCATION FFTW3::fftw3${DACE_FFTW3_P} IMPORTED_LOCATION)
    get_target_property(DACE_FFTW3_CONFIGS FFTW3::fftw3${DACE_FFTW3_P} IMPORTED_CONFIGURATIONS)
  endif()
  if(DACE_FFTW3_LOCATION OR DACE_FFTW3_CONFIGS)
    set(DACE_FFTW3_LIB FFTW3::fftw3${DACE_FFTW3_P})
    set(DACE_FFTW3_DIRS ${FFTW3${DACE_FFTW3_P}_LIBRARY_DIRS})
  elseif(PKG_CONFIG_FOUND)
    pkg_check_modules(DACE_FFTW3${DACE_FFTW3_P}_PC QUIET IMPORTED_TARGET fftw3${DACE_FFTW3_P})
    if(NOT DACE_FFTW3${DACE_FFTW3_P}_PC_FOUND)
      continue()
    endif()
    set(DACE_FFTW3_LIB PkgConfig::DACE_FFTW3${DACE_FFTW3_P}_PC)
    set(DACE_FFTW3_DIRS ${DACE_FFTW3${DACE_FFTW3_P}_PC_LIBRARY_DIRS})
  else()
    continue()
  endif()
  find_library(DACE_FFTW3${DACE_FFTW3_P}_THREADS NAMES fftw3${DACE_FFTW3_P}_omp fftw3${DACE_FFTW3_P}_threads
               HINTS ${DACE_FFTW3_DIRS})
  if(DACE_FFTW3${DACE_FFTW3_P}_THREADS)
    list(APPEND DACE_LIBS ${DACE_FFTW3${DACE_FFTW3_P}_THREADS})
  endif()
  list(APPEND DACE_LIBS ${DACE_FFTW3_LIB})
  set(DACE_FFTW3_FOUND ON)
endforeach()
if(NOT DACE_FFTW3_FOUND)
  message(FATAL_ERROR "FFTW3 not found: neither its CMake package nor pkg-config's fftw3 or fftw3f (set FFTW_ROOT)")
endif()
